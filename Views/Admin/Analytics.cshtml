@model WaitWise.ViewModels.AnalyticsViewModel

@{
    ViewData["Title"] = "Service Analytics & Predictor Intelligence";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-bar-chart-line text-primary me-2"></i> Queue & Wait-Time Analytics
        </h2>
        <span class="text-muted">Empirical insights generated from real completed consultations and used by the Smart Predictor.</span>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
    </a>
</div>

<!-- Primary Stats Overview -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <span class="text-muted small fw-bold text-uppercase d-block mb-1">Total Consultations Recorded</span>
            <h2 class="display-5 fw-bold text-primary mb-0">@Model.TotalServiceLogsRecorded</h2>
            <small class="text-muted">Real historical datapoints stored in SQL Server</small>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <span class="text-muted small fw-bold text-uppercase d-block mb-1">Overall Facility Average Turnaround</span>
            <h2 class="display-5 fw-bold text-success mb-0">~@Model.OverallAverageDuration <small class="fs-4">minutes</small></h2>
            <small class="text-muted">Average duration per customer across all departments</small>
        </div>
    </div>
</div>

<!-- Department Service Duration Breakdown Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-white">
    <div class="card-header bg-white p-4 border-bottom">
        <h5 class="fw-bold text-dark mb-0">Department Performance & Statistical Distribution</h5>
        <small class="text-muted">Minimum, Average, and Peak consultation lengths recorded</small>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase text-muted">
                <tr>
                    <th class="ps-4">Department</th>
                    <th>Code Prefix</th>
                    <th>Consultations Recorded</th>
                    <th>Fastest Consultation</th>
                    <th>Average Turnaround</th>
                    <th class="text-end pe-4">Longest Consultation</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var stat in Model.DepartmentStats)
                {
                    <tr>
                        <td class="ps-4">
                            <strong class="text-dark">@stat.DepartmentName</strong>
                        </td>
                        <td>
                            <span class="badge bg-dark rounded-pill px-3 py-1 font-monospace">@stat.CodePrefix</span>
                        </td>
                        <td>@stat.TotalCompleted recorded</td>
                        <td>
                            <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">
                                @stat.MinMinutes mins
                            </span>
                        </td>
                        <td>
                            <strong class="text-primary fs-6">~@stat.AverageMinutes mins</strong>
                        </td>
                        <td class="text-end pe-4">
                            <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2 py-1">
                                @stat.MaxMinutes mins
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Hourly Traffic Distribution (Visual Bars) -->
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <h5 class="fw-bold text-dark mb-1">Hourly Consultation Load & Peak Times</h5>
    <p class="text-muted small mb-4">Volume of consultations completed during different hours of the day.</p>

    <div class="row g-3">
        @if (Model.HourlyStats.Any())
        {
            var maxHour = Model.HourlyStats.Max(h => h.ConsultationCount);
            foreach (var h in Model.HourlyStats)
            {
                var percent = maxHour > 0 ? (int)((double)h.ConsultationCount / maxHour * 100) : 0;
                <div class="col-md-6 col-lg-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="text-dark">@h.HourFormatted</strong>
                            <span class="badge bg-primary rounded-pill">@h.ConsultationCount completed</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: @percent%;" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center text-muted py-4">
                No hourly distribution data logged yet.
            </div>
        }
    </div>
</div>

<!-- Detailed Service Logs Audit Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="card-header bg-white p-4 border-bottom">
        <h5 class="fw-bold text-dark mb-0">Detailed Service History Audit (Latest 25)</h5>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase text-muted">
                <tr>
                    <th class="ps-4">Ticket</th>
                    <th>Department</th>
                    <th>Desk</th>
                    <th>Actual Duration</th>
                    <th class="text-end pe-4">Timestamp</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.DetailedLogs)
                {
                    <tr>
                        <td class="ps-4 font-monospace fw-bold">@log.TicketNumber</td>
                        <td>@log.DepartmentName</td>
                        <td>@log.CounterName</td>
                        <td>
                            <span class="badge bg-light text-dark border px-3 py-1 font-monospace">
                                @log.DurationMinutes mins
                            </span>
                        </td>
                        <td class="text-end pe-4 text-muted small">
                            @log.CompletedAt.ToLocalTime().ToString("MMM dd, yyyy - hh:mm tt")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
