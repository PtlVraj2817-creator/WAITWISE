@{
    ViewData["Title"] = "No Counters Available";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card border-0 shadow-sm p-5 rounded-4">
            <i class="bi bi-display-slash text-warning fs-1 mb-3"></i>
            <h3 class="fw-bold">No Active Counters Found</h3>
            <p class="text-muted">There are currently no active service counters configured in the system. An administrator can add new counters from the Admin Dashboard.</p>
            <div class="mt-4">
                <a asp-controller="Admin" asp-action="Counters" class="btn btn-primary rounded-pill px-4">
                    Manage Counters
                </a>
            </div>
        </div>
    </div>
</div>
